# =============================================================================
# FastAPI 后端环境变量配置模板
# =============================================================================
# 复制此文件为 .env 并根据实际情况填写各配置项
# 所有带 [必填] 标记的变量必须填写，其余变量保留默认值即可运行
# =============================================================================


# =============================================================================
# 1. 基础应用配置
# =============================================================================

# 应用名称，显示在 API 文档和日志中
APP_NAME=AiInterviewAgent

# 调试模式开关：True 开启详细错误信息和自动重载，False 用于生产环境
DEBUG=True

# 应用版本号，显示在 /docs 等接口中
VERSION=1.0.0


# =============================================================================
# 2. 数据库配置 [必填]
# =============================================================================

# PostgreSQL 数据库连接字符串
# 格式: postgresql+asyncpg://用户名:密码@主机:端口/数据库名
# Docker 开发环境（端口映射到 15432）:
#   postgresql+asyncpg://postgres:password@localhost:15432/ai_interview
# 本地 PostgreSQL（默认端口 5432）:
#   postgresql+asyncpg://postgres:password@localhost:5432/ai_interview
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ai_interview

# 数据库连接池大小：保持的最小连接数
DATABASE_POOL_SIZE=20

# 连接池溢出上限：当池满时可额外创建的最大连接数
DATABASE_MAX_OVERFLOW=10


# =============================================================================
# 3. Redis 配置 [必填]
# =============================================================================

# Redis 连接地址，用于缓存、WebSocket 状态管理和 Celery 消息队列
# Docker 开发环境: redis://localhost:16379/0
# 本地 Redis: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Redis 连接池大小
REDIS_POOL_SIZE=10


# =============================================================================
# 4. JWT 认证配置 [必填]
# =============================================================================

# JWT 签名密钥，用于签发和验证用户 Token
# ⚠️ 生产环境务必修改为强随机字符串，泄露将导致身份认证失效
JWT_SECRET_KEY=your-secret-key-change-in-production

# JWT 签名算法，保持默认 HS256 即可
JWT_ALGORITHM=HS256

# Access Token 有效期（分钟），过期后需重新登录
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh Token 有效期（天），用于无感刷新 Access Token
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7


# =============================================================================
# 5. Celery 异步任务配置 [必填]
# =============================================================================

# Celery 消息队列（Broker），使用 Redis 的不同数据库号与缓存隔离
CELERY_BROKER_URL=redis://localhost:6379/1

# Celery 任务结果存储后端
CELERY_RESULT_BACKEND=redis://localhost:6379/2


# =============================================================================
# 6. AI 模型配置
# =============================================================================

# ---- 统一 LLM 配置（推荐，优先使用）----
# 支持任何 OpenAI 兼容的 API 端点（智谱、月之暗面、百度、阿里、OpenAI 等）
# 若配置了 LLM_API_KEY，将优先使用，不再读取 QWEN_API_KEY / OPENAI_API_KEY
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# ---- DashScope 多模态专属配置 ----
# Qwen3-Omni 实时音视频、Qwen-VL 视觉分析等专用
# 纯文本 LLM 请使用上方统一 LLM 配置
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1


# =============================================================================
# 7. 阿里云多服务配置 [必填]
# =============================================================================
# 阿里云的不同服务使用不同的认证体系：
#   - ACCESS_KEY / SECRET_KEY: 账号级凭证，用于 OSS 等需 RAM 权限的服务
#   - ASR_APPKEY / TTS_APPKEY: 具体 AI 服务的应用级凭证
# =============================================================================

# ---- 阿里云账号凭证（可选） ----
# 阿里云 AccessKey ID 和 Secret，用于 OSS 对象存储身份认证
# 获取地址: https://ram.console.aliyun.com/manage/ak
# ⚠️ 当前项目中 OSS 服务定义了但未被任何功能调用，不配置不影响现有功能
#   视频/简历等文件存储使用本地磁盘（uploads/ 目录）
#   如需云端长期存档，可配置此项
ALIYUN_ACCESS_KEY=your-aliyun-access-key
ALIYUN_SECRET_KEY=your-aliyun-secret-key

# ---- OSS 对象存储（可选） ----
# OSS Bucket 名称，用于存储面试录音、简历文件等
# ⚠️ 当前视频上传保存到本地磁盘，不配置不影响功能
ALIYUN_OSS_BUCKET=your-oss-bucket

# OSS 服务端点（Endpoint），决定数据存储的物理区域
# 国内杭州节点: oss-cn-hangzhou.aliyuncs.com
# 国内上海节点: oss-cn-shanghai.aliyuncs.com
# 若 Bucket 在其他区域，请替换为对应 Endpoint
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# ---- 阿里云语音识别 (ASR)（可选） ----
# ASR AppKey，用于"一句话识别"服务，将面试者语音转为文字
# 获取地址: 阿里云智能语音交互控制台 -> 创建项目后获取 AppKey
# ⚠️ ASR 已迁移到前端（Web Speech API 等），后端只保存音频到临时目录
#   不配置不影响面试对话功能
ALIYUN_ASR_APPKEY=your-asr-appkey

# ---- 阿里云语音合成 (TTS) ----
# TTS AppKey，用于语音合成（文字转语音）
# ⚠️ 当前 TTS 优先使用讯飞（见下方配置），此项保留向后兼容
ALIYUN_TTS_APPKEY=


# =============================================================================
# 8. TTS 语音合成配置
# =============================================================================

# TTS 服务提供商选择：
#   auto   - 自动检测：优先讯飞，无配置时依次尝试阿里云、Qwen、mock
#   xfyun  - 讯飞星火（推荐，音质好、延迟低）
#   aliyun - 阿里云（备选）
#   qwen   - 通义千问（备选）
#   mock   - 模拟模式（返回静音数据，用于测试）
TTS_PROVIDER=auto

# ---- 讯飞星火 TTS（推荐） ----
# 获取地址: https://www.xfyun.cn/
XFYUN_APP_ID=your-xfyun-app-id
XFYUN_APP_KEY=your-xfyun-api-key
XFYUN_APP_SECRET=your-xfyun-api-secret

# 发音人: xiaoyan(女声)/xiaofeng(男声)/xiaomei(甜美女声)/xiaoyu(童声)/xiaoxin(小新)
XFYUN_VOICE=xiaoyan

# 语速 0-100，默认 50 为正常语速
XFYUN_SPEED=50

# 音量 0-100
XFYUN_VOLUME=50

# 音调 0-100
XFYUN_PITCH=50


# =============================================================================
# 9. 微信小程序配置
# =============================================================================

# 微信小程序 AppID 和 AppSecret，用于微信登录
# 获取地址: https://mp.weixin.qq.com/ -> 开发 -> 开发管理 -> 开发设置
# 若仅使用 H5 端，可留空
WECHAT_APP_ID=
WECHAT_APP_SECRET=


# =============================================================================
# 10. 服务器配置
# =============================================================================

# 服务监听地址，0.0.0.0 允许所有网络接口访问
HOST=0.0.0.0

# 服务监听端口
PORT=8000


# =============================================================================
# 11. 跨域 (CORS) 配置
# =============================================================================
# 仅在开发环境需要调整，生产环境保持默认值即可

# 允许跨域请求的源地址列表，JSON 数组格式
# ⚠️ 当 allow_credentials=true 时，不能使用 "*" 通配符
CORS_ORIGINS=["http://localhost:3333","http://localhost:3334","http://localhost:5173","http://localhost:3000","http://localhost:8080","http://127.0.0.1:3333","http://127.0.0.1:3334","http://127.0.0.1:5173","http://127.0.0.1:3000","http://127.0.0.1:8080"]

# 是否允许跨域请求携带 Cookie/Authorization 等凭证信息
CORS_ALLOW_CREDENTIALS=true

# 允许的 HTTP 方法
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE","OPTIONS","PATCH"]

# 允许的请求头，["*"] 表示允许所有
CORS_ALLOW_HEADERS=["*"]


# =============================================================================
# 12. 日志配置
# =============================================================================

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 日志文件存放目录
LOG_DIR=logs

# 是否使用 JSON 格式输出日志（便于日志收集系统解析）
LOG_JSON_FORMAT=false

# 单个日志文件最大大小（字节），默认 10MB
LOG_MAX_BYTES=10485760

# 保留的日志文件备份数量
LOG_BACKUP_COUNT=10

# 是否在控制台输出日志
LOG_CONSOLE=true


# =============================================================================
# 13. SMTP 邮件配置
# =============================================================================

# SMTP 服务器地址，用于发送验证码邮件
# QQ 邮箱: smtp.qq.com
# 网易邮箱: smtp.163.com
# Gmail: smtp.gmail.com
SMTP_HOST=smtp.qq.com

# SMTP 端口：465 用于 SSL，587 用于 TLS
SMTP_PORT=465

# SMTP 登录邮箱地址
SMTP_USER=your-email@qq.com

# SMTP 密码或授权码（非邮箱登录密码）
SMTP_PASSWORD=your-smtp-password

# 发件人显示地址
SMTP_FROM=your-email@qq.com

# SSL 和 TLS 二选一，通常 SSL + 465 或 TLS + 587
SMTP_USE_SSL=true
SMTP_USE_TLS=false


# =============================================================================
# 14. 推荐系统配置（向后兼容）
# =============================================================================

# 推荐系统数据库连接（已合并到主数据库 ai_interview）
# 保留此配置仅用于向后兼容，实际应与 DATABASE_URL 指向同一数据库
REC_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:15432/ai_interview


# =============================================================================
# 本地开发快速参考
# =============================================================================
#
# 方式 1: Docker 基础设施（推荐）
#   1. 在项目根目录运行: docker-compose -f docker-compose.infra.yml up -d
#   2. 使用以下配置:
#      DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:15432/ai_interview
#      REDIS_URL=redis://localhost:16379/0
#      CELERY_BROKER_URL=redis://localhost:16379/1
#      CELERY_RESULT_BACKEND=redis://localhost:16379/2
#
# 方式 2: 本地安装的服务
#   - 使用默认端口: PostgreSQL 5432, Redis 6379
#
# 详见: fastapi/docs/INFRA_SETUP.md
# =============================================================================
